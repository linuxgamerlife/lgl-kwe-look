<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">

  <id>com.linuxgamerlife.lgl-kwe-look</id>

  <name>LGL KWE Look</name>
  <summary>One appearance tool for GTK, Qt5 and Qt6 in a KineticWE session</summary>

  <metadata_license>MIT</metadata_license>
  <project_license>MIT AND BSD-2-Clause AND MPL-2.0</project_license>

  <description>
    <p>
      LGL KWE Look replaces nwg-look, qt5ct and qt6ct with a single native Qt6 app. Choose the
      GTK theme, icon theme, mouse cursor and fonts once, style Qt5 and Qt6 apps, and apply
      everything in one step.
    </p>
    <p>
      In a KineticWE session the icon and cursor choice is written to every place that reads it
      (the session's appearance file, the compositor, kdeglobals, qt5ct, qt6ct and gsettings), so
      it survives the next login. The Noctalia colour scheme is shown as live and is never edited.
    </p>
  </description>

  <launchable type="desktop-id">com.linuxgamerlife.lgl-kwe-look.desktop</launchable>

  <url type="homepage">https://github.com/linuxgamerlife/lgl-kwe-look</url>
  <url type="bugtracker">https://github.com/linuxgamerlife/lgl-kwe-look/issues</url>

  <developer id="com.linuxgamerlife">
    <name>LinuxGamerLife</name>
  </developer>

  <categories>
    <category>Settings</category>
    <category>DesktopSettings</category>
  </categories>

  <keywords>
    <keyword>theme</keyword>
    <keyword>appearance</keyword>
    <keyword>icons</keyword>
    <keyword>cursor</keyword>
    <keyword>gtk</keyword>
    <keyword>qt5ct</keyword>
    <keyword>qt6ct</keyword>
    <keyword>nwg-look</keyword>
  </keywords>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>

  <requires>
    <display_length compare="ge">700</display_length>
  </requires>

  <releases>
    <release version="0.1.0" date="2026-09-21">
      <description>
        <p>First development release.</p>
      </description>
    </release>
  </releases>

  <content_rating type="oars-1.1"/>

</component>
